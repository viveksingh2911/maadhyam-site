# Copy to .env and edit before deploying.

# Absolute public origin. Canonical tags, the sitemap, RSS and Open Graph URLs
# are all built from this, so it MUST be your real domain in production.
SITE_URL=http://127.0.0.1:8000

# Long random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs out every admin session.
SECRET_KEY=

# sqlite:///C:/path/to/site.db  or  postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=

APP_NAME=Maadhyam International
ENV=development
DEBUG=true

# Set to true once you are serving over HTTPS.
COOKIE_SECURE=false

SESSION_MAX_AGE=43200
MAX_UPLOAD_MB=12

# First-run administrator. Used only when the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@maadhyam.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026
BOOTSTRAP_ADMIN_NAME=Site Administrator
